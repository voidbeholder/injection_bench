# Скопируйте в .env. Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Пресеты моделей (идентификаторы из каталога OpenRouter, нужна поддержка tools).
# Пусто — значения по умолчанию из run_bench.py.
MODEL_WEAK=meta-llama/llama-3.1-8b-instruct
MODEL_MEDIUM=openai/gpt-4.1-mini
MODEL_STRONG=anthropic/claude-sonnet-4.5

# Другой OpenAI-совместимый провайдер (необязательно), например https://router.huggingface.co/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
